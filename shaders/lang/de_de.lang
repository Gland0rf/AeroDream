# Living Worlds
screen.MATERIALS = Ressourcenpaket-Materialien
screen.DIMENSIONS = Biome & Dimensionen
option.PUDDLE_STRENGTH = Regenpfuetzen-Abdeckung
option.PUDDLE_STRENGTH.comment = Pfuetzen auf freiem, fast waagerechtem Boden wachsen bei Naesse und trocknen langsam. Keine Pfuetzen auf Pflanzen, Schnee oder Eis.
option.PUDDLE_QUALITY = Pfuetzen-Reflexionen
option.PUDDLE_QUALITY.comment = Himmel spiegelt Wolken und Mond; Szene spiegelt auch sichtbares Gelaende. Aus deaktiviert Pfuetzen.
value.PUDDLE_QUALITY.0 = Aus
value.PUDDLE_QUALITY.1 = Himmel
value.PUDDLE_QUALITY.2 = Himmel + Szene
option.BIOME_ATMOSPHERE = Biom-Atmosphaere
option.BIOME_ATMOSPHERE.comment = Kuehle Bergluft, warme Wuestenhorizonte und feuchter Dschungeldunst. Sanfte Uebergaenge dauern etwa acht Sekunden.
option.UNDERWATER_RAYS = Sonnenstrahlen unter Wasser
option.UNDERWATER_RAYS.comment = Strahlen mit Schattenpruefung. Benoetigt Schatten und Tageslicht in einer Dimension mit Himmelslicht.
option.UNDERWATER_RAY_SAMPLES = Unterwasser-Strahlenqualitaet
option.UNDERWATER_RAY_SAMPLES.comment = Mehr Volumenproben verbessern die Strahlen und erhoehen die GPU-Last.
option.DIMENSION_STYLE = Aero-Stil fuer Nether & Ende
option.DIMENSION_STYLE.comment = Bernstein und Seelengruen im Nether, violetter Perlmutt-Himmel im Ende. Null verwendet native Nebelfarben.
option.HANDHELD_LIGHT = Licht in der Hand
option.HANDHELD_LIGHT.comment = Lokales Licht ohne Schatten aus beiden Haenden. Zwei Lichtquellen verdoppeln die Helligkeit nicht.
option.HANDHELD_RADIUS = Handlicht-Reichweite
option.HANDHELD_RADIUS.comment = Maximale Reichweite bei Lichtstaerke 15. Schwaechere Lichtquellen haben eine kleinere Reichweite.
option.SHOOTING_STAR_STRENGTH = Sternschnuppen
option.SHOOTING_STAR_STRENGTH.comment = Seltene kurze Meteore in klaren Nachthimmeln. Null deaktiviert sie.
option.AERO_MOON_PHASES = Minecraft-Mondphasen
option.AERO_MOON_PHASES.comment = Zeigt die aktuelle Mondphase statt eines staendigen Vollmonds.
option.MATERIAL_MAPS = Materialformat des Ressourcenpakets
option.MATERIAL_MAPS.comment = Optionale Normalen- und Glanzkarten: oldPBR oder LabPBR 1.3. Passend zum Ressourcenpaket waehlen; Vanilla verwendet Aus.
value.MATERIAL_MAPS.0 = Aus (Vanilla)
value.MATERIAL_MAPS.1 = oldPBR
value.MATERIAL_MAPS.2 = LabPBR 1.3
option.NORMAL_STRENGTH = Normalenkarten-Detail
option.NORMAL_STRENGTH.comment = Oberflaechendetail aus Normalenkarten. Veraendert keine Blockgeometrie.
option.MATERIAL_SHINE = Materialkarten-Glanz
option.MATERIAL_SHINE.comment = Staerke der durch Materialkarten gesteuerten Reflexionen und Glanzlichter.

# Glass & Motion
screen.PHOTO = Fotomodus
option.AERO_COLORED_SHADOWS = Farbige Glasschatten
option.AERO_COLORED_SHADOWS.comment = Sonnenlicht durch Glas wirft farbige Schatten. Benoetigt Schatten; mehrere Scheiben verwenden die naechste Schattenebene.
option.CLOUD_MODE = Wolkenform
option.CLOUD_MODE.comment = Flache Schleier oder volumetrische Wolken zwischen Y174 und Y236. Volumetrische Wolken kosten viel GPU-Leistung.
value.CLOUD_MODE.0 = Schleier
value.CLOUD_MODE.1 = Volumetrisch
option.CLOUD_SAMPLES = Volumetrische Wolkenqualitaet
option.CLOUD_SAMPLES.comment = Mehr Integrationsschritte verbessern Wolkentiefe und Abstufungen bei hoeherer GPU-Last.
option.STORM_WIND = Wetterboeen-Staerke
option.STORM_WIND.comment = Regen verstaerkt gemeinsame Pflanzenboeen und erhoeht geometrische Wasserwellen sanft.
option.WATER_SURFACE_MOTION = Bewegung der Wasseroberflaeche
option.WATER_SURFACE_MOTION.comment = Kleine echte Hoehenwellen mit passenden Reflexionsnormalen. Null laesst die Geometrie flach; bei wassergefuellten Bloecken gegebenenfalls ausschalten.
option.COLORED_LIGHT_STRENGTH = Farbiges Blocklicht
option.COLORED_LIGHT_STRENGTH.comment = Lokale Farbe von sichtbaren Lampen und emissiven Materialkarten mit Tiefenpruefung. Licht ausserhalb des Bildes verwendet normales Blocklicht.
option.COLORED_LIGHT_SAMPLES = Blocklicht-Farbqualitaet
option.COLORED_LIGHT_SAMPLES.comment = Mehr Proben erkennen kleine sichtbare Lichtquellen besser. Farbreichweite etwa sechs Bloecke.
option.TAA_ENABLED = Zeitliche Kantenglaettung
option.TAA_ENABLED.comment = Versetzte Abtastung und begrenzte Bildhistorie. Ersetzt FXAA; bewegte Pflanzen und Objekte koennen Nachzieheffekte zeigen.
value.TAA_ENABLED.0 = Aus
value.TAA_ENABLED.1 = An
option.TAA_HISTORY = Zeitliche Glaettung
option.TAA_HISTORY.comment = Mehr Bildhistorie glaettet staerker, kann aber Bewegungsspuren verstaerken. Verdeckungswechsel verwerfen die Historie.
option.AERO_PHOTO_MODE = Fotomodus
option.AERO_PHOTO_MODE.comment = Optionale Tiefenunschaerfe und Kinobalken. Standardmaessig aus; pausiert Minecraft nicht und versteckt kein HUD.
option.PHOTO_AUTOFOCUS = Foto-Autofokus
option.PHOTO_AUTOFOCUS.comment = Fokus auf die geglaettete Bildmitte. Fuer manuelle Fokusentfernung ausschalten.
option.PHOTO_FOCUS_DISTANCE = Manuelle Fokusentfernung
option.PHOTO_FOCUS_DISTANCE.comment = Fokusentfernung in Bloecken bei aktivem Fotomodus und ausgeschaltetem Autofokus.
option.PHOTO_APERTURE = Foto-Unschaerfe
option.PHOTO_APERTURE.comment = Tiefenunschaerfe bis zwoelf Pixel. Null deaktiviert die Unschaerfe, erhaelt aber die Kinobalken.
option.PHOTO_LETTERBOX = Kinobalken
option.PHOTO_LETTERBOX.comment = Bildhoehenanteil der oberen und unteren Balken im Fotomodus. Null erhaelt das ganze Bild.
